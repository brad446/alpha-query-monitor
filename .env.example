# Kalshi credentials
KALSHI_EMAIL=your@email.com
KALSHI_PASSWORD=yourpassword

# Risk parameters (override defaults in config.py)
MAX_BANKROLL_PCT_PER_TRADE=0.02     # 2% of bankroll max per trade
KELLY_FRACTION=0.25                  # quarter-Kelly for safety
MIN_TRUE_PROBABILITY=0.91            # only trade >= 91% confidence
MAX_TRUE_PROBABILITY=0.97            # avoid near-certain mispriced contracts
MIN_EDGE=0.03                        # minimum edge over market price (in prob points)
MAX_OPEN_POSITIONS=5                 # concurrent open trades
DAILY_LOSS_LIMIT_PCT=0.05            # stop trading if down 5% on the day
DRAWDOWN_LIMIT_PCT=0.10              # circuit-breaker if down 10% from peak

# Environment: 'demo' or 'prod'
KALSHI_ENV=demo
