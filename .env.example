# Pittsburgh Phil — Belmont Stakes 2026 Configuration

# Starting bankroll in dollars
STARTING_BANKROLL=10000

# Kelly fraction (0.25 = quarter Kelly — conservative, recommended)
KELLY_FRACTION=0.25

# Max single-bet size as fraction of bankroll (0.05 = 5%)
MAX_BET_FRACTION=0.05

# Set to false to enable live bet logging
DRY_RUN=true

# Path to race card JSON (default: belmont 2026)
RACE_CARD_PATH=races/belmont_2026_race_card.json
