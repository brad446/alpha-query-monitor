# Kalshi credentials
KALSHI_EMAIL=your@email.com
KALSHI_PASSWORD=yourpassword

# DRY_RUN=true  → reads real prices, logs what it would trade, never places orders
# DRY_RUN=false → places real orders with real money
DRY_RUN=true
SIMULATED_BALANCE=10000

# Risk settings
MIN_TRUE_PROBABILITY=0.91
MAX_TRUE_PROBABILITY=0.97
MIN_EDGE=0.03
MAX_OPEN_POSITIONS=5
KELLY_FRACTION=0.25
MAX_BANKROLL_PCT_PER_TRADE=0.02
DAILY_LOSS_LIMIT_PCT=0.05
DRAWDOWN_LIMIT_PCT=0.10
